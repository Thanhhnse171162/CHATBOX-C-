<Window x:Class="ChatClient.RoomInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thong tin" Height="760" Width="520" MinHeight="520" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
  <Grid Margin="16">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="{StaticResource CardRadius}" Padding="14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
          <TextBlock x:Name="RoomNameText" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="File phuong tien, file va lien ket" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">
          <TabItem Header="File phuong tien">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <WrapPanel x:Name="MediaWrap" Margin="2"/>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="File">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="FilesPanel"/>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Lien ket">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="LinksPanel"/>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
    </Border>
  </Grid>
</Window>
