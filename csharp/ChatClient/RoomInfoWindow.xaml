<Window x:Class="ChatClient.RoomInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Info" Height="700" Width="480"
        MinHeight="480" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
  <Grid Margin="14">
    <Border Background="White" CornerRadius="14">
      <Border.Effect>
        <DropShadowEffect Color="#000" Opacity="0.07" BlurRadius="16" ShadowDepth="2"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="20,16">
          <StackPanel Orientation="Horizontal">
            <Border Width="44" Height="44" CornerRadius="22"
                    Background="{StaticResource PrimaryBrush}"
                    Margin="0,0,14,0" VerticalAlignment="Center">
              <TextBlock Text="💬" FontFamily="Segoe UI Emoji" FontSize="22"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="RoomNameText" FontSize="16" FontWeight="Bold"
                         Foreground="{StaticResource TextBrush}"/>
              <TextBlock Text="Media, files &amp; links" FontSize="12"
                         Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
          <TabItem Header="📷  Ảnh &amp; video">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
              <WrapPanel x:Name="MediaWrap" Margin="4"/>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="📁  Files">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
              <StackPanel x:Name="FilesPanel" Margin="4"/>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="🔗  Links">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
              <StackPanel x:Name="LinksPanel" Margin="4"/>
            </ScrollViewer>
          </TabItem>
        </TabControl>

      </Grid>
    </Border>
  </Grid>
</Window>
