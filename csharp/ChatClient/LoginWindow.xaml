<Window x:Class="ChatClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Group — Sign In" Height="520" Width="440"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}">
  <Grid>
    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="16" Padding="32" MaxWidth="400"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
        <TextBlock Text="Sign In" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="host:port (TCP) — ví dụ localhost:7000" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
        <TextBlock Text="TCP host:port" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="HostBox" Text="localhost:7000" Padding="12" Margin="0,0,0,10"/>
        <TextBlock Text="HTTP port" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="HttpPortBox" Text="7001" Padding="12" Margin="0,0,0,10"/>
        <TextBlock Text="Username" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="UserBox" Padding="12" Margin="0,0,0,10"/>
        <TextBlock Text="Password" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        <PasswordBox x:Name="PassBox" Padding="12" Margin="0,0,0,10"/>
        <TextBlock x:Name="StatusText" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Button Content="Join Chat" Click="Join_Click" Background="{StaticResource PrimaryBrush}"
                Foreground="White" FontWeight="SemiBold" Padding="14" BorderThickness="0" Cursor="Hand" Margin="0,4,0,0"/>
        <Button Content="Register" Click="Register_Click" Background="Transparent" Foreground="{StaticResource PrimaryBrush}"
                BorderThickness="0" Margin="0,8,0,0" Cursor="Hand"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
