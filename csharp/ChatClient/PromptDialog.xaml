<Window x:Class="ChatClient.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <StackPanel Margin="16" MinWidth="280">
    <TextBlock x:Name="PromptText" Margin="0,0,0,8"/>
    <TextBox x:Name="InputBox" Padding="8" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Width="72" Margin="0,0,8,0"/>
      <Button Content="OK" IsDefault="True" Width="72" Click="Ok_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
