<Window x:Class="ChatClient.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource BgBrush}">
  <Grid Margin="10">
    <Border Background="White" CornerRadius="14" Padding="26,22" MinWidth="340">
      <Border.Effect>
        <DropShadowEffect Color="#000" Opacity="0.09" BlurRadius="20" ShadowDepth="2"/>
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0"
                   FontWeight="SemiBold" FontSize="15"
                   Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,14"/>

        <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,0,0,18"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Hủy" IsCancel="True" MinWidth="88" Margin="0,0,10,0"
                  Background="{StaticResource HoverBrush}"
                  Foreground="{StaticResource SubTextBrush}"/>
          <Button Content="OK" IsDefault="True" MinWidth="88"
                  Click="Ok_Click"
                  Background="{StaticResource PrimaryBrush}"
                  Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
