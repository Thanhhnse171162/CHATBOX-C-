<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat" Height="820" Width="1260" MinHeight="600" MinWidth="880"
        Background="{StaticResource BgBrush}">

  <Grid>
    <Grid.ColumnDefinitions>
      <!-- Panel 1: Left Nav (72px) -->
      <ColumnDefinition Width="72"/>
      <!-- Panel 2: Conversations (240px) -->
      <ColumnDefinition Width="240"/>
      <!-- Panel 3: Chat Area -->
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ════════════════════════════════════
         PANEL 1: LEFT NAV
         ════════════════════════════════════ -->
    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E4E6EA" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP: Avatar circle 42px -->
        <Grid Margin="0,16,0,0" Width="42" Height="42" HorizontalAlignment="Center">
          <Border CornerRadius="21" Background="#0084FF">
             <TextBlock x:Name="AvatarInitial" Text="?" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Ellipse Width="10" Height="10" Fill="#31A24C" Stroke="White" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- MIDDLE nav icons -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,20,0,0">
          <Grid Margin="0,0,0,8">
             <Border Width="3" Background="#0084FF" HorizontalAlignment="Left" Margin="-14,0,0,0" Height="24" CornerRadius="2"/>
             <Button Width="44" Height="44" Background="#E7F3FF" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                  <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                  </Style>
                </Button.Resources>
                <TextBlock Text="💬" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0084FF"/>
             </Button>
          </Grid>
          <Button Click="CreateGroup_Click" Width="44" Height="44" Background="Transparent" BorderThickness="0" Cursor="Hand">
             <Button.Resources>
               <Style TargetType="Border">
                 <Setter Property="CornerRadius" Value="10"/>
               </Style>
             </Button.Resources>
             <TextBlock Text="👥" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#65676B"/>
          </Button>
        </StackPanel>

        <!-- BOTTOM -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,16">
          <Button Width="40" Height="40" Background="Transparent" BorderThickness="0" Margin="0,0,0,8" Cursor="Hand">
             <TextBlock Text="⚙️" FontFamily="Segoe UI Emoji" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#65676B"/>
          </Button>
          <Button Click="Logout_Click" Width="40" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand">
             <TextBlock Text="🚪" FontFamily="Segoe UI Emoji" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#65676B"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ════════════════════════════════════
         PANEL 2: CONVERSATIONS
         ════════════════════════════════════ -->
    <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E4E6EA" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <!-- Header -->
          <TextBlock Text="Messages" FontWeight="Bold" FontSize="18" Foreground="#1C1E21" Padding="16,20"/>
          
          <!-- Search -->
          <Border Background="#F0F2F5" CornerRadius="17" Height="34" Margin="12,0,12,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="🔍" FontFamily="Segoe UI Emoji" FontSize="14" Foreground="#BCC0C4" VerticalAlignment="Center" Margin="10,0,6,0"/>
              <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" TextChanged="SearchBox_TextChanged" VerticalContentAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- List -->
        <ListBox x:Name="RoomsList" SelectionChanged="RoomsList_SelectionChanged" Background="Transparent" BorderThickness="0" Margin="0">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                          <Border Background="{TemplateBinding Background}">
                              <ContentPresenter/>
                          </Border>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#EEF2FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#F8F9FA"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- Each Item 68px Height -->
              <Grid Height="68">
                <Border Width="3" Background="#0084FF" HorizontalAlignment="Left" Visibility="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                
                <Grid Margin="12,0,12,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  
                  <Grid Grid.Column="0" Width="46" Height="46" VerticalAlignment="Center">
                    <Border CornerRadius="23" Background="{Binding Name, Converter={StaticResource NameToColor}}">
                      <TextBlock Text="{Binding Name, Converter={StaticResource NameToInitials}}" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Ellipse Width="10" Height="10" Fill="#31A24C" Stroke="White" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                  </Grid>
                  
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Grid>
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#1C1E21" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                      <TextBlock Text="12:45 PM" FontSize="11" Foreground="#BCC0C4" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="Message preview..." FontSize="13" Foreground="#65676B" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ════════════════════════════════════
         PANEL 3: CHAT AREA
         ════════════════════════════════════ -->
    <Grid Grid.Column="2" Background="#FFFFFF">
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="68"/>
      </Grid.RowDefinitions>

      <!-- TOP BAR -->
      <Border Grid.Row="0" BorderBrush="#E4E6EA" BorderThickness="0,0,0,1" Padding="16,0">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="36" Height="36" CornerRadius="18" Background="#0084FF" Margin="0,0,10,0">
               <TextBlock x:Name="ChatAvatarInitial" Text="?" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="ChatTitleText" FontWeight="Bold" FontSize="16" Foreground="#1C1E21"/>
              <TextBlock Text="● Active now • 12 online" Foreground="#31A24C" FontSize="12"/>
            </StackPanel>
          </StackPanel>
          
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Width="34" Height="34" Background="Transparent" BorderThickness="0" Margin="0,0,8,0">
               <TextBlock Text="🔍" FontFamily="Segoe UI Emoji" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0084FF"/>
            </Button>
            <Button Click="Info_Click" Width="34" Height="34" Background="Transparent" BorderThickness="0">
               <TextBlock Text="ⓘ" FontFamily="Segoe UI Emoji" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0084FF"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- MESSAGES AREA -->
      <ScrollViewer Grid.Row="1" x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
        <StackPanel x:Name="MessagesPanel" Margin="20,16"/>
      </ScrollViewer>

      <!-- INPUT BAR -->
      <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E4E6EA" BorderThickness="0,1,0,0" Padding="12,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <Button Click="Image_Click" Width="34" Height="34" Background="Transparent" BorderThickness="0" Cursor="Hand">
               <TextBlock Text="🖼️" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0084FF"/>
            </Button>
            <Button Click="Attach_Click" Width="34" Height="34" Background="Transparent" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand">
               <TextBlock Text="⊕" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0084FF"/>
            </Button>
            <Button x:Name="EmojiButton" Click="Emoji_Click" Width="34" Height="34" Background="Transparent" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand">
               <TextBlock Text="🙂" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0084FF"/>
            </Button>
            <Button Click="VoiceCall_Click" Width="34" Height="34" Background="Transparent" BorderThickness="0" Margin="4,0,0,0" Cursor="Hand">
               <TextBlock Text="🎤" FontFamily="Segoe UI Emoji" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0084FF"/>
            </Button>
          </StackPanel>

          <Border Grid.Column="1" Background="#F0F2F5" CornerRadius="22" Padding="14,0" VerticalAlignment="Center" Height="44">
             <TextBox x:Name="MessageInput" Background="Transparent" BorderThickness="0" FontSize="14" FontFamily="Segoe UI Emoji" VerticalContentAlignment="Center" KeyDown="MessageInput_KeyDown"/>
          </Border>

          <Button Grid.Column="2" Click="Send_Click" Width="40" Height="40" Background="#0084FF" BorderThickness="0" Margin="12,0,0,0" VerticalAlignment="Center" Cursor="Hand">
             <Button.Resources>
               <Style TargetType="Border">
                 <Setter Property="CornerRadius" Value="20"/>
               </Style>
             </Button.Resources>
             <TextBlock Text="➤" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
          </Button>
        </Grid>
      </Border>

    </Grid>

    <!-- ── Download overlay (stays in chat column) ── -->
    <Border x:Name="DownloadPanel" Grid.Column="2"
            Background="#1E293B" CornerRadius="12" Padding="16,12"
            Width="360" HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Margin="16" Visibility="Collapsed">
      <Border.Effect>
        <DropShadowEffect Color="#000" Opacity="0.22" BlurRadius="18" ShadowDepth="3"/>
      </Border.Effect>
      <StackPanel>
        <TextBlock x:Name="DownloadNameText" Foreground="White"
                   FontWeight="SemiBold" FontSize="13"/>
        <ProgressBar x:Name="DownloadBar" Height="5" Margin="0,9,0,4"
                     Maximum="100"
                     Foreground="#0084FF"/>
        <TextBlock x:Name="DownloadStatsText" Foreground="#94A3B8" FontSize="11"/>
      </StackPanel>
    </Border>

    <!-- ── Emoji popup ── -->
    <Popup x:Name="EmojiPopup" Grid.Column="2"
           PlacementTarget="{Binding ElementName=EmojiButton}"
           Placement="Top" StaysOpen="False">
      <Border Background="#FFFFFF" CornerRadius="14" Margin="0,0,0,8" Width="348" Height="420">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" Opacity="0.14"/>
        </Border.Effect>
        <DockPanel>
          <!-- Search Bar -->
          <Border DockPanel.Dock="Top" Height="36" Margin="10,10,10,6" Background="#F0F2F5" CornerRadius="18">
            <TextBox Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="10,0"/>
          </Border>
          <!-- Tabs -->
          <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Margin="6,0" x:Name="EmojiTabsPanel">
               <Button Width="36" Height="36" Background="#E7F3FF" BorderThickness="0" Margin="2,0" FontFamily="Segoe UI Emoji" FontSize="18">
                  <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></Button.Resources>
                  <TextBlock Text="😀"/>
               </Button>
            </StackPanel>
          </ScrollViewer>
          <Border DockPanel.Dock="Top" Height="1" Background="#E4E6EA" Margin="0,4"/>
          <!-- Grid -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
             <WrapPanel x:Name="EmojiPanel" Width="332" Margin="8"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Popup>

    <!-- ── Sticker popup ── -->
    <Popup x:Name="StickerPopup" Grid.Column="2"
           PlacementTarget="{Binding ElementName=EmojiButton}"
           Placement="Top" StaysOpen="False">
      <Border Background="White"
              BorderBrush="#E4E6EA" BorderThickness="1"
              CornerRadius="14" Padding="8">
        <Border.Effect>
          <DropShadowEffect Color="#000" Opacity="0.10" BlurRadius="20" ShadowDepth="3"/>
        </Border.Effect>
        <WrapPanel x:Name="StickerPanel" Width="260"/>
      </Border>
    </Popup>

  </Grid>
</Window>
