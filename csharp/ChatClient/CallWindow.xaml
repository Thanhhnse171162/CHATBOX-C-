<Window x:Class="ChatClient.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Call" Height="320" Width="360" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#0B1220">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" CornerRadius="18" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" Padding="18">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock x:Name="KindText" Foreground="#E5E7EB" FontSize="13" HorizontalAlignment="Center"/>
        <TextBlock x:Name="PeerText" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        <TextBlock x:Name="TimerText" Foreground="#94A3B8" FontSize="16" Margin="0,18,0,0" HorizontalAlignment="Center" Text="00:00"/>
      </StackPanel>
    </Border>

    <Button Grid.Row="2" Content="End Call" Click="EndCall_Click" Background="#DC2626" Foreground="White"
            BorderThickness="0" Padding="16,10" FontWeight="SemiBold"/>
  </Grid>
</Window>
