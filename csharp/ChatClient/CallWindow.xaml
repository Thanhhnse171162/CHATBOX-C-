<Window x:Class="ChatClient.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Call" Height="320" Width="360" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#1E293B">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
      <TextBlock x:Name="KindText" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
      <TextBlock x:Name="PeerText" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,8,0,0" HorizontalAlignment="Center"/>
      <TextBlock x:Name="TimerText" Foreground="#94A3B8" FontSize="16" Margin="0,16,0,0" HorizontalAlignment="Center" Text="00:00"/>
    </StackPanel>
    <Button Grid.Row="2" Content="End Call" Click="EndCall_Click" Background="#DC2626" Foreground="White"
            BorderThickness="0" Padding="16,10" FontWeight="SemiBold" Cursor="Hand"/>
  </Grid>
</Window>
